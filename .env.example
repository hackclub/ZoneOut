# Reference only. The real file is .env.local and is never committed.
# Paste every value unquoted.

# database - pooled for the functions, unpooled for db/migrate.mjs
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb

# hack club auth - every callback below must also be registered in the Developer Apps portal
HC_CLIENT_ID=965538623dabd2cd0a02c2d7e88372ee
HC_CLIENT_SECRET=replace-me
HC_REDIRECT_URIS=http://localhost:3000/api/auth/callback,https://zoneout-ysws.vercel.app/api/auth/callback,https://zoneout.dino.icu/api/auth/callback

# signs the session cookie and the OAuth state; at least 32 characters
SESSION_SECRET=replace-me

# optional - unlocks the config report at /api/health?token=<value>
# HEALTH_TOKEN=
